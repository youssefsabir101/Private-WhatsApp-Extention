{
  "manifest_version": 3,
  "name": "Private WhatsApp",
  "version": "3.3.2",
  "description": "On-device visual privacy controls for WhatsApp Web.",
  "icons": {
    "128": "icon.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Private WhatsApp",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}
