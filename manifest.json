{
  "manifest_version": 3,
  "name": "Private WhatsApp",
  "version": "2.0.0",
  "description": "Local visual privacy controls for WhatsApp Web.",
  "permissions": ["storage"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Private WhatsApp",
    "default_popup": "popup.html"
  }
}
